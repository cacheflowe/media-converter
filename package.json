{
  "name": "media-converter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:component": "tsc && vite build --mode component",
    "build:pages": "tsc && vite build --mode pages",
    "build:all": "npm run build && npm run build:component && npm run build:pages",
    "preview": "vite preview",
    "update-libs": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "heic-to": "^1.6.7",
    "mediabunny": "^1.65.0",
    "onnxruntime-web": "1.30.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/upng-js": "^2.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
